<Page x:Class="ЧудоОбувь.OrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ЧудоОбувь"
      mc:Ignorable="d"
      d:DesignHeight="650"
      d:DesignWidth="1000"
      Title="Заказы"
      FontFamily="Calibri">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Таблица заказов -->
        <DataGrid Name="OrdersGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionChanged="OrdersGrid_SelectionChanged"
                  Margin="5"
                  FontSize="16"
                  SelectionMode="Single">


            <DataGrid.Columns>
                <DataGridTextColumn Header="№ Заказа"
                                    Binding="{Binding OrderID}"/>

                <DataGridTextColumn Header="Дата"
                                    Binding="{Binding OrderDate, StringFormat=\{0:dd.MM.yyyy\}}"/>

                <DataGridTextColumn Header="ФИО Клиента"
                                    Binding="{Binding ClientName}"/>

                <DataGridTextColumn Header="Сумма"
                                    Binding="{Binding Cost}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Подробности заказа -->
        <Grid Name="OrderDetailsPanel"
              Grid.Row="3"
              Visibility="Collapsed"
              Margin="5">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="150"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Состав заказа"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,10,0,5"/>

            <!-- Товары в заказе -->
            <DataGrid Name="OrderItemsGrid"
                      Grid.Row="1"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      FontSize="14">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Модель"
                                        Binding="{Binding Stock.Products.ProductName}"/>

                    <DataGridTextColumn Header="Размер"
                                        Binding="{Binding Stock.Sizes.SizeValue}"/>

                    <DataGridTextColumn Header="Кол-во"
                                        Binding="{Binding Quantity}"/>

                    <!-- Кнопки редактирования (только админ) -->
                    <DataGridTemplateColumn Width="120"
                                            Visibility="Collapsed">

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">

                                    <Button Content="x"
                                            Width="25"
                                            Height="25"
                                            Background="#FFD55555"
                                            Foreground="White"
                                            Click="BtnRemoveItem_Click"
                                            Tag="{Binding}"/>

                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>

            <!-- Панель редактирования -->
            <StackPanel Name="EditOrderPanel"
                        Grid.Row="2"
                        Visibility="Collapsed"
                        Margin="0,10,0,10"
                        Orientation="Horizontal">

                <TextBlock Text="Дата заказа:"
                           FontSize="16"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           FontWeight="SemiBold"
                           Name="OrderDateTB"
                           Visibility="Collapsed"/>

                <DatePicker FontSize="16"
                            Width="150"
                            Height="30"
                            Name="OrderDatePicker"
                            Visibility="Collapsed"
                            SelectedDateChanged="OrderDatePicker_SelectedDateChanged"/>

            </StackPanel>

            <!-- Кнопки действий: публикация + удаление -->
            <StackPanel Orientation="Horizontal"
                        Grid.Row="3"
                        Margin="0,10,0,0">

                <!-- Удаление заказа (менеджер и админ) -->
                <Button Name="BtnDeleteOrder"
                        Content="Удалить заказ"
                        Click="BtnDeleteOrder_Click"
                        Background="#FFD55555"
                        Foreground="White"
                        Height="40"
                        Padding="15,0"
                        Visibility="Collapsed"
                        FontSize="16"
                        VerticalAlignment="Center"/>

            </StackPanel>

        </Grid>
    </Grid>
</Page>
