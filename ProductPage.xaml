<Page x:Class="ChudoObuv.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ChudoObuv"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Список товаров" FontFamily="Calibri" IsVisibleChanged="Page_IsVisibleChanged">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#D2F6E7"></Border>
        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <TextBlock Text="Поиск " TextAlignment="Right" Width="100" FontSize="20"></TextBlock>
            <TextBox Name="TBoxSearch" TextChanged="TBoxSearch_TextChanged" Width="300" FontSize="20" Height="35"></TextBox>
            <TextBlock Text=" "/>
            <ComboBox Name="ComboCategory" SelectionChanged="ComboCategory_SelectionChanged" FontSize="15" Width="120" Height="35">
                    <TextBlock Width="80">Все</TextBlock>
                <TextBlock Width="80"> мужское</TextBlock>
                <TextBlock Width="80"> женское</TextBlock>
                <TextBlock Width="80"> детское</TextBlock>
            </ComboBox>
            <TextBlock Text=" "/>
            <ComboBox Name="ComboSort" SelectionChanged="ComboSort_SelectionChanged" FontSize="15" Width="250" Height="35">
                <TextBlock Width="220"> От а до я</TextBlock>
                <TextBlock Width="220"> От я до а</TextBlock>
                <TextBlock Width="220"> По убыванию в цене</TextBlock>
                <TextBlock Width="220"> По возрастанию в цене</TextBlock>
            </ComboBox>
        </WrapPanel>
        <ListView Name="ProductListView" Grid.Row="2">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"></ColumnDefinition>
                            <ColumnDefinition Width="1450"></ColumnDefinition>
                            <ColumnDefinition Width="250"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border BorderThickness="1" BorderBrush="Black" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="0" Grid.RowSpan="4" ></Border>
                        <Image Width="200" Grid.Column="0" Grid.RowSpan="4" Stretch="UniformToFill" HorizontalAlignment="Center">
                            <Image.Source>
                                <Binding Path="ImagePath">
                                    <Binding.TargetNullValue>
                                        <ImageSource>
                                            ObuvRes/picture.png
                                        </ImageSource>
                                    </Binding.TargetNullValue>
                                </Binding>
                            </Image.Source>
                        </Image>
                        <TextBlock Text="{Binding ProductName}" Width="auto" HorizontalAlignment="Center" Grid.ColumnSpan="2" FontSize="30" TextWrapping="Wrap" Height="auto" Grid.Column="1"></TextBlock>
                        <TextBlock Text="{Binding SubcategoryName}" Height="auto" Width="auto" TextWrapping="Wrap" FontSize="30" Grid.Column="2" Grid.Row="1" HorizontalAlignment="Right"></TextBlock>
                        <TextBlock Text="{Binding ManufactureName}" FontSize="30" Margin="5" Height="auto" Width="auto" Grid.Row="1" Grid.Column="1"/>
                        <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Price}" FontSize="30" Margin="5" Height="auto" Width="auto"></TextBlock>
                            <TextBlock Text=" рублей" FontSize="30" Height="auto" Margin="5" Width="auto"></TextBlock>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" Margin="5" Grid.Column="1" Height="auto" Width="1000" Grid.Row="2" HorizontalAlignment="Left" FontSize="25" TextWrapping="Wrap"></TextBlock>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
